# Copy to proxy/.env and adjust. All settings are optional.
HYDRA_MCP_HOST=127.0.0.1
HYDRA_MCP_PORT=8765
# Exact URL your MCP clients use. It becomes the OAuth `resource` of every account route.
# Defaults to http://127.0.0.1:<port>; set it behind a tunnel or a reverse proxy.
# HYDRA_MCP_PUBLIC_URL=http://127.0.0.1:8765
# Where the SQLite database and the admin token live.
# HYDRA_MCP_DATA_DIR=~/.hydra-mcp
# Fixed admin token (otherwise generated on first start).
# HYDRA_MCP_ADMIN_TOKEN=
